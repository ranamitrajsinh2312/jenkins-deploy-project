# ==========================================
# DevOpsFlow Portal - Environment Configuration
# ==========================================

# Application Settings
APP_NAME=DevOpsFlow Portal
APP_VERSION=1.0.0
NODE_ENV=development
PORT=3000

# Docker & Container Registry Settings
DOCKER_HUB_USER=ranamitrajsinh23
DOCKER_IMAGE_NAME=ranamitrajsinh23/jenkins-deploy-project-app

# PostgreSQL Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devops_db
DB_USER=postgres
DB_PASSWORD=postgrespassword

# Connection Pool Tuning
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000
